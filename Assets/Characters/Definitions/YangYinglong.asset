  dayOneActivity: "\u9E7F\u89C1\u6DF1\u6B63\u5728\u5206\u6790\u6C34\u8D28\uFF0C\u5316\u5B66\u5206\u6790\u5BA4\u63A5\u53D6\u4EFB\u52A1\u3002"
  dayOneTask: "\u91C7\u96C6\u8680\u6D77\u6D77\u6C34\u6837\u672C\u3002\n\u6768\u5E94\u9686\u529D\u963B\u540E\u987A\u5EF6\u81F3\u7B2C\u4E8C\u65E5\uFF0CDay1\u53EA\u767B\u8BB0\u987A\u5EF6\uFF1B\u5B9E\u9645\u6C34\u6837\u5728event-05\u91C7\u96C6\u3002"
  planningNotes: "\u539F\u5907\u6CE8\u4E2D\u6709\u201C\u6BD4\u5366\u8C61\u5F81\u8FC7\u5EA6\u201D\u7684\u5B57\u6837\uFF1B\u6B64\u5904\u6309\u4EBA\u7269\u8868\u7684\u5927\u8FC7\u5366\u5F55\u5165\uFF0C\u4FDD\u7559\u8BE5\u6587\u672C\u5DEE\u5F02\u3002"
