  abilityDescription: "\u5927\u8FC7\u8C61\u5F81\u8FC7\u5EA6\u3001\u7269\u6781\u5FC5\u53CD\uFF0C\u4EE5\u9AD8\u5927\u6811\u6728\u6216\u623F\u6881\u4E3A\u8C61\u5F81\u3002\u6811\u6728\u8FC7\u76DB\u800C\u8870\uFF0C\u6743\u80FD\u4E0E\u51CB\u4EA1\u6709\u5173\uFF1B\u4F7F\u4E8B\u7269\u5FEB\u901F\u884D\u5316\u81F3\u8870\u4EA1\u72B6\u6001\u3002"
  background: "\u9752\u9706\u53F8\u662F\u7F57\u5929\u6559\u6267\u884C\u90E8\uFF0C\u8D1F\u8D23\u76F4\u63A5\u6267\u884C\u52AB\u707E\u7684\u6536\u5BB9\u3002\u6768\u5E94\u9686\u4E3A\u7EAF\u6218\u58EB\u3002"
  appearanceNotes: "\u6309\u6218\u6597\u4EBA\u5458\u8BBE\u8BA1\uFF0C\u6CBF\u7528\u7F57\u5929\u6559\u52BF\u529B\u670D\u9970\uFF0C\u5E76\u4E0E\u666E\u901A\u5B89\u4FDD
