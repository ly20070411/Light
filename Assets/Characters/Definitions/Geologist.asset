  abilityDescription: "\u5C6F\u5366\u5177\u6709\u751F\u547D\u64CD\u7EB5\u7684\u6743\u80FD\uFF0C\u542B\u56F0\u96BE\u4E0E\u671D\u6C14\u84EC\u52C3\u4E4B\u610F\uFF0C\u8C61\u5F81\u8349\u6728\u7834\u571F\u800C\u51FA\u3002"
  background: "\u9752\u9F99\u9986\u4E3A\u84EC\u83B1\u9986\u4E0B\u5C5E\u7814\u7A76\u751F\u7269\u3001\u751F\u6001\u4E0E\u533B\u5B66\u7684\u5B66\u9662\u3002"
