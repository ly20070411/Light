  dayOneTask: "\u91C7\u96C6\u5730\u56FE\u4E2D\u5206\u5E03\u7684\u8FDE\u7406\u679D\u690D\u682A\uFF0C\u63D0\u4EA4\u540E\u83B7\u5F97\u8FDE\u7406\u679D\u6807\u672C\u3002\n\u91C7\u96C6\u5730\u56FE\u4E2D\u5206\u5E03\u7684\u8FDE\u7406\u679D\u690D\u682A\uFF0C\u63D0\u4EA4\u540E\u83B7\u5F97\u8FDE\u7406\u679D\u6807\u672C\u3002"
  planningNotes: "\u6839\u636E\u65B0\u7248\u7EC6\u7EB2\u5F55\u5165\u59D3\u540D\u4E0E\u8D44\u6599\u3002\u539F\u6709\u89D2\u8272
