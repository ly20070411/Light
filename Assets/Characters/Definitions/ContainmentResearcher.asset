  abilityDescription: "\u4E95\u5366\u542B\u7A33\u5B9A\u4E0E\u53EF\u6301\u7EED\u53D1\u5C55\u7684\u610F\u4E49\uFF0C\u4EE5\u6C34\u4E95\u4E3A\u8C61\u5F81\uFF0C\u6743\u80FD\u4E0E\u6536\u5BB9\u3001\u4FDD\u5B58\u6709\u5173\u3002"
  background: "\u6240\u5C5E\u90E8\u95E8\u8D1F\u8D23\u52AB\u707E\u7684\u6536\u5BB9\u7BA1\u7406\u4E0E\u7814\u7A76\u3002\u4F7F\u7528\u9AD8\u79D1\u6280\u88C5\u5907\u6218\u6597\uFF0C\u504F\u6587\u804C\u3002"
  appearanceNotes: "\u7F57\u5929\u6559\u6536\u5BB9\u7BA1\u7406\u4E0E\u7814\u7A76\u4EBA\u5458\u7684\u57FA\u7840\u670D\u9970\uFF1B\u5F53\u524D\u5360\u4F4D\u4E3A\u7070\u84DD\u5DE5\u4F5C\u670D\u4E0E\u4EAE\u9752\u8272\u79D1\u6280\u8BBE\u5907\u3002"
  dayOneLocation: "\u5185\u6D77\u4FA7\u7801\u5934 / \u751F\u6D3B\u533A\u8D70\u5ECA\uFF0F\u9910\u5385\u53A8\u623F
