  dayOneActivity: "\u5E38\u6708\u5BB9\u5728\u5185\u6D77\u4FA7\u7801\u5934\u642C\u8FD0\u7269\u8D44\uFF0C\u65C1\u8FB9\u505C\u9760\u79D1\u8003\u8239\u3002"
  dayOneTask: "\u7801\u5934\u62FF\u8D77\u88C5\u5907\u7BB1\uFF1A\u98DF\u6750\u7BB1\u9001\u751F\u6D3B\u533A\u8D70\u5ECA\uFF0C\u5DE5\u5177\u7BB1\u9001\u4ED3\u50A8\u533A\uFF0C\u79D1\u7814\u4EEA\u5668\u7BB1\u9001\u79D1\u7814\u533A\u8D70\u5ECA\uFF1B\u5B8C\u6210\u540E\u5F97\u5230\u677E\u8338\u5E72\u3002\n\u7801\u5934\u62FF\u8D77\u88C5\u5907\u7BB1\uFF1A\u98DF\u6750\u7BB1\u9001\u751F\u6D3B\u533A\u8D70\u5ECA\uFF0C\u5DE5\u5177\u7BB1\u9001\u4ED3\u50A8\u533A\uFF0C\u79D1\u7814\u4EEA\u5668\u7BB1\u9001\u79D1\u7814\u533A\u8D70\u5ECA\uFF1B\u5B8C\u6210\u540E\u5F97\u5230\u677E\u8338\u5E72\u3002"
  planningNotes: "\u6839\u636E\u65B0\u7248\u7EC6\u7EB2\u5F55\u5165\u59D3\u540D\u4E0E\u8D44\u6599\u3002\u539F\u6709\u89D2\u8272
    ID \u548C\u5360\u4F4D\u8D44\u4EA7\u7EE7\u7EED\u4F7F\u7528\uFF1B\u65B0\u7248\u4EFB\u52A1\u4EC5\u4E3A\u7F16\u8F91\u8D44\u6599\uFF0C\u65E7\u53EF\u73A9\u573A\u666F\u672A\u8FC1\u79FB\u3002\n\u7F57\u5929\u6559\u7684\u6536\u5BB9\u90E8\uFF0C\u6DF1\u6CC9\u53F8\uFF0C\u8D1F\u8D23\u52AB\u707E\u7684\u6536\u5BB9\u7BA1\u7406\u4E0E\u7814\u7A76\u4F7F\u7528\u9AD8\u79D1\u6280\u88C5\u5907\u6218\u6597\uFF0C\u504F\u6587\u804C\u4E95\u5366\u542B\u4E49\u4E3A\u7A33\u5B9A\u4E0E\u53EF\u6301\u7EED\u53D1\u5C55\uFF0C\u4EE5\u6C34\u4E95\u4E3A\u8C61\u5F81\uFF0C\u6743\u80FD\u4E0E\u201C\u6536\u5BB9\uFF0C\u4FDD\u5B58\u6709\u5173\u201D"
