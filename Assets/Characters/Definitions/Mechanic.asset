  dayOneTask: "\u4FEE\u590D\u88C5\u5907\uFF0C\u5B8C\u6210\u540E\u53EF\u627E\u5510\u6666\u8BA2\u5236\u88C5\u5907\u3002\n\u4FEE\u590D\u88C5\u5907\uFF0C\u5B8C\u6210\u540E\u53EF\u627E\u5510\u6666\u8BA2\u5236\u88C5\u5907\u3002"
  planningNotes: "\u6839\u636E\u65B0\u7248\u7EC6\u7EB2\u5F55\u5165\u59D3\u540D\u4E0E\u8D44\u6599\u3002\u539F\u6709\u89D2\u8272
