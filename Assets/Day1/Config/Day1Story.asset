      character: {fileID: 11400000, guid: a615874ceb9170548b8a79476228e78b, type: 2}
      text: "\u690D\u7269\u4E5F\u5F52\u8FD9\u6B21\u91C7\u6837\uFF1F"
      portrait: {fileID: 0}
    - speaker: "\u5730\u8D28\u5B66\u5BB6"
      character: {fileID: 0}
      text: "\u751F\u957F\u7684\u4F4D\u7F6E\u8981\u548C\u5730\u8868\u72B6\u51B5\u4E00\u8D77\u770B\u3002\u5E2E\u6211\u53D6\u4E00\u4EFD\u5B8C\u6574\u6837\u672C\uFF0C\u6839\u90E8\u548C\u5468\u56F4\u7684\u571F\u4E5F\u7559\u4E00\u4E9B\u3002"
