    - speaker: "\u6536\u5BB9\u90E8\u5B89\u4FDD"
      character: {fileID: 0}
      text: "\u8FD9\u5957\u4F5C\u6218\u8BBE\u5907\u8FD8\u6CA1\u901A\u8FC7\u68C0\u4FEE\u3002\u5E2E\u6211\u628A\u5F02\u5E38\u4F4D\u7F6E\u627E\u51FA\u6765\uFF0C\u5148\u6062\u590D\u5230\u53EF\u7528\u72B6\u6001\u3002"
