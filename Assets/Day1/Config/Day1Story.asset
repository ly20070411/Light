    handover:
    - speaker: "\u5730\u8D28\u5B66\u5BB6"
      character: {fileID: 0}
      text: "\u591F\u505A\u57FA\u7840\u8BB0\u5F55\u4E86\u3002\u4F60\u53D6\u4E0B\u5B83\u7684\u4F4D\u7F6E\uFF0C\u6211\u4E5F\u4F1A\u4E00\u8D77\u8BB0\u4E0A\u3002"
