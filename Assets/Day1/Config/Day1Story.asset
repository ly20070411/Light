      text: "\u6211\u518D\u590D\u6838\u4E00\u904D\u3002\u88C5\u5907\u80FD\u6B63\u5E38\u4F7F\u7528\uFF0C\u5B89\u4FDD\u51C6\u5907\u624D\u7B97\u505A\u5B8C\u3002"
