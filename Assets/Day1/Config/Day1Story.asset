    ongoing:
    - speaker: "\u5730\u8D28\u5B66\u5BB6"
      character: {fileID: 0}
      text: "\u8981\u4FDD\u7559\u5B8C\u6574\u7ED3\u6784\uFF0C\u522B\u53EA\u6458\u53F6\u5B50\u3002"
