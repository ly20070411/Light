    - speaker: 
      character: {fileID: 11400000, guid: bec857fb62b6ace47bf2cc651ad52840, type: 2}
      text: "\u5148\u786E\u8BA4\u5404\u7EC8\u7AEF\u80FD\u5426\u6B63\u5E38\u8BFB\u53D6\u3002\u62FF\u5230\u539F\u59CB\u68C0\u67E5\u7ED3\u679C\u5C31\u56DE\u6765\uFF0C\u522B\u6025\u7740\u66FF\u8BB0\u5F55\u4E0B\u7ED3\u8BBA\u3002"
