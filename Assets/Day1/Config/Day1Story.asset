  - roleId: yang-yinglong
    offer:
    - speaker: 
      character: {fileID: 11400000, guid: a615874ceb9170548b8a79476228e78b, type: 2}
      text: "\u6768\u5E94\u9686\uFF0C\u5916\u56F4\u60C5\u51B5\u5982\u4F55\uFF1F"
