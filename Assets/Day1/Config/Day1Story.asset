    portrait: {fileID: 0}
  npcs:
  - roleId: lin-xi
    offer:
    - speaker: 
      character: {fileID: 11400000, guid: a615874ceb9170548b8a79476228e78b, type: 2}
      text: "\u6797\u6EAA\uFF0C\u7AD9\u5185\u8BBE\u5907\u600E\u4E48\u6837\uFF1F"
      portrait: {fileID: 0}
    - speaker: 
      character: {fileID: 11400000, guid: bec857fb62b6ace47bf2cc651ad52840, type: 2}
      text: "\u51E0\u8DEF\u4FE1\u606F\u8FD8\u6CA1\u63A5\u987A\u3002\u6211\u5148\u6838\u5BF9\u673A\u623F\uFF0C\u4F60\u66FF\u6211\u770B\u770B\u603B\u63A7\u5BA4\u7684\u7EC8\u7AEF\u72B6\u6001\u3002"
      portrait: {fileID: 0}
    - speaker: 
      character: {fileID: 11400000, guid: a615874ceb9170548b8a79476228e78b, type: 2}
      text: "\u9700\u8981\u67E5\u54EA\u4E9B\uFF1F"
