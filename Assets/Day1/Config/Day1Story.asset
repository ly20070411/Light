    - speaker: "\u6536\u5BB9\u90E8\u5B89\u4FDD"
      character: {fileID: 0}
      text: "\u5BF9\uFF0C\u5DE5\u5177\u5728\u5DE5\u4F5C\u53F0\u4E0A\u3002\u5148\u68C0\u67E5\uFF0C\u518D\u51B3\u5B9A\u600E\u4E48\u52A8\u624B\u3002"
      portrait: {fileID: 0}
    accepted:
    - speaker: 
      character: {fileID: 11400000, guid: a615874ceb9170548b8a79476228e78b, type: 2}
      text: "\u6211\u5148\u68C0\u67E5\u6545\u969C\uFF0C\u518D\u5904\u7406\u5F02\u5E38\u90E8\u4EF6\u3002"
