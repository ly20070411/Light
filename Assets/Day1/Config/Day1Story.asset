      portrait: {fileID: 0}
    - speaker: 
      character: {fileID: 11400000, guid: a615874ceb9170548b8a79476228e78b, type: 2}
      text: "\u6C34\u6587\u65B9\u5411\uFF0C\u6211\u8BB0\u4E0B\u4E86\u3002\u8FD9\u91CC\u6709\u4EC0\u4E48\u9700\u8981\u51C6\u5907\u7684\uFF1F"
      portrait: {fileID: 0}
    - speaker: "\u6C34\u6587\u5B66\u5BB6"
      character: {fileID: 0}
      text: "\u6211\u8981\u628A\u65B0\u53D6\u7684\u6D77\u6C34\u6837\u672C\u548C\u7AD9\u91CC\u7684\u73AF\u5883\u8BB0\u5F55\u5BF9\u7167\u3002\u4F60\u65B9\u4FBF\u65F6\uFF0C\u66FF\u6211\u5E26\u4E00\u4EFD\u8680\u6D77\u6D77\u6C34\u56DE\u6765\u3002"
      portrait: {fileID: 0}
    - speaker: 
      character: {fileID: 11400000, guid: a615874ceb9170548b8a79476228e78b, type: 2}
      text: "\u53D6\u6837\u8981\u6C42\u4E5F\u4E00\u5E76\u7ED9\u6211\u3002"
      portrait: {fileID: 0}
    - speaker: "\u6C34\u6587\u5B66\u5BB6"
      character: {fileID: 0}
      text: "\u4F4D\u7F6E\u3001\u65F6\u95F4\u548C\u5BB9\u5668\u72B6\u6001\u90FD\u8981\u8BB0\u5F55\u3002\u6837\u672C\u6709\u5F02\u5E38\uFF0C\u522B\u81EA\u884C\u5904\u7406\uFF0C\u76F4\u63A5\u5E26\u56DE\u539F\u59CB\u8BB0\u5F55\u3002"
      portrait: {fileID: 0}
    accepted:
    - speaker: 
      character: {fileID: 11400000, guid: a615874ceb9170548b8a79476228e78b, type: 2}
      text: "\u6211\u5148\u786E\u8BA4\u5916\u56F4\u5B89\u6392\uFF0C\u5F00\u653E\u540E\u518D\u53BB\u91C7\u6837\u3002"
      portrait: {fileID: 0}
    ongoing:
    - speaker: "\u6C34\u6587\u5B66\u5BB6"
      character: {fileID: 0}
      text: "\u91C7\u6837\u524D\u5148\u786E\u8BA4\u5916\u56F4\u662F\u5426\u5F00\u653E\uFF0C\u5BB9\u5668\u548C\u539F\u59CB\u8BB0\u5F55\u90FD\u522B\u9057\u6F0F\u3002"
      portrait: {fileID: 0}
    handover:
    - speaker: 
      character: {fileID: 11400000, guid: a615874ceb9170548b8a79476228e78b, type: 2}
      text: "\u8680\u6D77\u4FA7\u4ECA\u5929\u8FD8\u6CA1\u5F00\u653E\uFF0C\u6C34\u6837\u660E\u5929\u518D\u53D6\u3002"
      portrait: {fileID: 0}
    - speaker: "\u6C34\u6587\u5B66\u5BB6"
      character: {fileID: 0}
      text: "\u77E5\u9053\u4E86\uFF0C\u5148\u6309\u5B89\u4FDD\u5B89\u6392\u3002\u6211\u628A\u5206\u6790\u53F0\u51C6\u5907\u597D\uFF0C\u660E\u5929\u53D6\u56DE\u6765\u518D\u5904\u7406\u3002"
      portrait: {fileID: 0}
    completed:
    - speaker: "\u6C34\u6587\u5B66\u5BB6"
      character: {fileID: 0}
      text: "\u6C34\u6837\u660E\u5929\u518D\u53D6\u3002\u4ECA\u5929\u5148\u628A\u51C6\u5907\u5DE5\u4F5C\u505A\u5B8C\u3002"
      portrait: {fileID: 0}
  - roleId: geologist
    offer:
    - speaker: "\u5730\u8D28\u5B66\u5BB6"
      character: {fileID: 0}
      text: "\u6211\u6765\u81EA\u9752\u9F99\u9986\uFF0C\u5730\u8D28\u65B9\u5411\uFF0C\u6B63\u5728\u8BB0\u5F55\u8FD9\u91CC\u7684\u690D\u7269\u5206\u5E03\u3002"
