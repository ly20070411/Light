    title: "\u8680\u6D77\u62A4\u536B\u91C7\u6837\u4E0E\u4E09\u6B21\u53D6\u6837\u6289\u62E9"
    route: "\u5171\u901A"
    kind: "\u4E3B\u7EBF\u4E8B\u4EF6"
    summary: "\u6768\u5E94\u9686\u521D\u6B65\u6E05\u7406\u5A01\u80C1\u540E\uFF0C\u4E3B\u89D2\u4E0E\u5E38\u6708\u5BB9\u3001\u9E7F\u89C1\u6DF1\u524D\u5F80\u8680\u6D77\u91C7\u6837\uFF0C\u53D1\u73B0\u7EE5\u6D77\u5830\u4FEE\u590D\u529F\u80FD\u6D88\u9000\u3002"
    trigger: "Day2\u5F00\u653E\u8680\u6D77\u6D77\u5CB8\uFF0C\u5904\u7406\u6B64\u524D\u987A\u5EF6\u7684\u91C7\u6837\u4EFB\u52A1\u3002"
    completion: "\u5B8C\u6210\u81F3\u5C11\u4E00\u6B21\u91C7\u6837\u540E\u8FD4\u56DE\uFF1B\u53EF\u7EE7\u7EED\u81F3\u4E09\u6B21\u91C7\u6837\u3002"
    interaction: "\u9996\u6B21\u91C7\u6837\u62A4\u536B\u6218 \u2192 \u9009\u62E9\u662F\u5426\u7B2C\u4E8C\u6B21\u91C7\u6837\uFF0F\u6218\u6597
      \u2192 \u9009\u62E9\u662F\u5426\u7B2C\u4E09\u6B21\u91C7\u6837\uFF0F\u6218\u6597
      \u2192 \u62A4\u9001\u8FD4\u56DE\u3002"
    staging: "\u7B2C\u4E09\u6B21\u5B8C\u6210\u540E\u9E7F\u89C1\u6DF1\u56E0\u7CBE\u795E\u635F\u4F24\u660F\u8FF7\uFF1B\u6853\u7389\u9274\u4EE5\u80FD\u529B\u4FDD\u62A4\u5176\u4E0D\u518D\u53D7\u8BA4\u77E5\u635F\u4F24\u5E76\u62A4\u9001\u56DE\u7AD9\u3002"
    designNotes: "\u6BCF\u6B21\u91C7\u6837\u5BF9\u5E94\u4E00\u573A\u6218\u6597\uFF1B\u5B8C\u6210\u4E09\u6B21\u4EC5\u83B7\u5F97\u4E00\u6B21\u9690\u85CF\u503C+1\u3002\u6218\u6597\u654C\u4EBA\u3001\u96BE\u5EA6\u3001\u5931\u8D25\u6D41\u7A0B\u4E0E\u6837\u672C\u5E93\u5B58\u4EFD\u6570\u5F85\u8865\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D121\u2014\u6B63\u6587\u6BB5\u843D130"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D121]\n\u6768\u5E94\u9686\u521D\u6B65\u6E05\u7406\u4E86\u5468\u8FB9\u5A01\u80C1\uFF0C\u73A9\u5BB6\u4E0E\u6536\u5BB9\u90E8\u5B89\u4FDD\uFF0C\u9E7F\u89C1\u6DF1\u524D\u5F80\u8680\u6D77\u91C7\u6837\uFF0C\u53D1\u73B0\u8BE5\u533A\u6BB5\u7EE5\u6D77\u5830\u4FEE\u590D\u529F\u80FD\u6B63\u5728\u6D88\u9000\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D123]\n\u573A\u666F\uFF1A\u8680\u6D77\u6D77\u5CB8\uFF0C\u5830\u4F53\u53D7\u5230\u4E25\u91CD\u4FB5\u8680\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D125]\n\u4E8B\u4EF6\uFF1A\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D126]\n\xB7\u73A9\u5BB6\u4FDD\u62A4\u9E7F\u89C1\u6DF1\u91C7\u6837\uFF0C\u7ECF\u5386\u4E00\u573A\u6218\u6597\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D127]\n\xB7\u9E7F\u89C1\u6DF1\u7B2C\u4E00\u6B21\u91C7\u6837\u540E\u5EFA\u8BAE\u6EDE\u7559\u4E00\u6BB5\u65F6\u95F4\u8FDB\u884C\u4E8C\u6B21\u91C7\u6837\uFF0C\u540C\u610F\u5219\u8FDB\u884C\u7B2C\u4E8C\u573A\u6218\u6597\uFF0C\u62D2\u7EDD\u5219\u8FD4\u56DE\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D128]\n\xB7\u7B2C\u4E8C\u6B21\u91C7\u6837\u5B8C\u6210\u540E\uFF0C\u9E7F\u89C1\u6DF1\u5EFA\u8BAE\u8FDB\u884C\u7B2C\u4E09\u6B21\u91C7\u6837\uFF0C\u540C\u610F\u5219\u8FDB\u884C\u7B2C\u4E09\u573A\u6218\u6597\uFF0C\u62D2\u7EDD\u5219\u8FD4\u56DE\uFF0C\u5B8C\u6210\u91C7\u6837\u540E\u9E7F\u89C1\u6DF1\u4F1A\u56E0\u7CBE\u795E\u635F\u4F24\u660F\u8FF7\uFF0C\u4E3B\u89D2\u5BF9\u5176\u4F7F\u7528\u80FD\u529B\uFF0C\u4FDD\u62A4\u5176\u4E0D\u5728\u53D7\u5230\u8BA4\u77E5\u635F\u4F24\u5E76\u62A4\u9001\u5176\u8FD4\u56DE\u79D1\u8003\u7AD9\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D130]\n\u8BF4\u660E\uFF1A\u5B8C\u6210\u4E09\u6B21\u91C7\u6837\u540E\u83B7\u5F97\u4E00\u70B9\u5267\u60C5\u9690\u85CF\u503C"
