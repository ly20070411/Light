  - id: event-03
    eventNumber: 3
    title: "\u751F\u6D3B\u7269\u8D44\u4E0E\u9996\u6B21\u795E\u79D8\u5F71\u5B50"
    route: "\u5171\u901A"
    kind: "\u4E3B\u7EBF\u4E8B\u4EF6"
    summary: "\u63A5\u5230\u5B89\u4FDD\u4EBA\u5458\u9886\u53D6\u751F\u6D3B\u7269\u8D44\u7684\u6D88\u606F\uFF1B\u5728\u751F\u6D3B\u533A\u4E0E\u9910\u684C\u7269\u8D44\u4EA4\u4E92\u540E\u770B\u5230\u795E\u79D8\u5F71\u5B50\uFF0C\u4F46\u5F53\u4E0B\u6CA1\u6709\u4EA7\u751F\u6000\u7591\u3002"
    trigger: "\u73AF\u5883\u4FE1\u606F\u67E5\u9605\u5B8C\u6210\uFF0C\u63A5\u5230\u5B89\u4FDD\u4EBA\u5458\u6D88\u606F\u3002"
    completion: "\u7269\u8D44\u4EA4\u4E92\u548C\u5F71\u5B50\u7ECF\u8FC7\u6F14\u51FA\u7ED3\u675F\u3002"
    interaction: "\u8EAB\u4EFD\u5361\u7EC8\u7AEF\uFF0F\u6D88\u606F\u5F62\u5F0F\u5F85\u8865
      \u2192 \u751F\u6D3B\u533A\u9910\u684C\u7269\u8D44 \u2192 \u5F71\u5B50\u6F14\u51FA\u3002"
    staging: "\u795E\u79D8\u5F71\u5B50\u4E3A\u8C2D\u793F\uFF1B\u53EF\u7528\u566A\u58F0\u3001\u96EA\u82B1\u5C4F\u53CA\u96EA\u82B1\u586B\u5145\u526A\u5F71\u8425\u9020\u7A81\u7136\u60CA\u6270\u3002"
    designNotes: "\u8C2D\u793F\u8EAB\u4EFD\u662F\u7B56\u5212\u4FE1\u606F\uFF0C\u4E0D\u5728\u672C\u9636\u6BB5\u5411\u73A9\u5BB6\u660E\u793A\u3002\u672A\u6000\u7591\u7684\u5177\u4F53\u72EC\u767D\u3001\u539F\u56E0\u5448\u73B0\u5F85\u8865\u3002\u6D88\u606F\u53D1\u4FE1\u5B89\u4FDD\u5177\u4F53\u662F\u8C01\u5F85\u786E\u8BA4\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D91\u2014\u6B63\u6587\u6BB5\u843D103"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D91]\n3.\u67E5\u9605\u5B8C\u6210\u540E\uFF0C\u63A5\u6536\u5230\u5B89\u4FDD\u4EBA\u5458\u53D6\u98DF\u5802\u9886\u53D6\u751F\u6D3B\u7269\u8D44\u7684\u6D88\u606F\uFF0C\u524D\u5F80\u98DF\u5802\u540E\u770B\u5230\u4E86\u4E00\u4E2A\u795E\u79D8\u7684\u5F71\u5B50\uFF08\u8C2D\u793F\uFF09\u4F46\u56E0\u4E3A\u67D0\u79CD\u539F\u56E0\u672A\u4EA7\u751F\u6000\u7591\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D93]\n\u573A\u666F\uFF1A3.\u751F\u6D3B\u533A\u8D70\u5ECA\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D95]\n\u9053\u5177\uFF1A6.\u751F\u6D3B\u7269\u8D44\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D97]\n\u4E8B\u4EF6\uFF1A\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D98]\n\xB7\u4E0E\u9910\u684C\u4E0A\u7269\u8D44\u4EA4\u4E92\uFF0C\u4EA4\u4E92\u5B8C\u6BD5\u540E\u64AD\u653E\u795E\u79D8\u5F71\u5B50\u7ECF\u8FC7\u7684\u52A8\u753B\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D100]\n\u8BF4\u660E\uFF1A\u5F71\u5B50\u7ECF\u8FC7\u65F6\uFF0C\u53EF\u4EE5\u52A0\u70B9\u9634\u95F4\u7279\u6548\uFF0C\u6BD4\u5982\u523A\u8033\u7684\u566A\u58F0\uFF0C\u96EA\u82B1\u5C4F\u4EC0\u4E48\u7684\uFF0C\u4E3B\u8981\u8FBE\u5230\u8BA9\u73A9\u5BB6\u4E00\u6FC0\u7075\u7684\u6548\u679C\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D101]\n\u4E2A\u4EBA\u8BBE\u60F3\u662F\u8BA9\u96EA\u82B1\u5C4F\u586B\u5145\u4EBA\u7269\u526A\u5F71\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D103]\n\u6CE8\uFF1A\u4E0D\u662F\u6BCF\u4E2A\u623F\u95F4\u90FD\u8981\u7ED8\u5236\uFF0C\u7EC6\u7EB2\u5199\u4E86\u4EC0\u4E48\u753B\u4EC0\u4E48\u5373\u53EF\u3002\u5E76\u4E14\u793A\u610F\u56FE\u4E2D\u623F\u95F4\u5927\u5C0F\u4E0D\u4EE3\u8868\u5B9E\u9645\u5927\u5C0F\uFF0C\u53EF\u4EE5\u5728\u5B9E\u9645\u7ED8\u5236\u65F6\u6309\u9700\u7F29\u653E"
