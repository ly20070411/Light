    title: "NE \xB7 \u5927\u89C4\u6A21\u73B0\u5B9E\u7A33\u5B9A\u951A\u62A4\u536B\u6218"
    route: NE
    kind: "\u4E3B\u7EBF\u4E8B\u4EF6"
    summary: "\u64A4\u79BB\u524D\u6853\u7389\u9274\u5230\u8680\u6D77\u5CB8\u521B\u5EFA\u5927\u89C4\u6A21\u73B0\u5B9E\u7A33\u5B9A\u951A\uFF0C\u6797\u6EAA\u4E0E\u6768\u5E94\u9686\u62A4\u536B\uFF1B\u951A\u5EFA\u7ACB\u540E\u4E3B\u89D2\u865A\u5F31\uFF0C\u968F\u540E\u5207\u6362\u64A4\u79BB\u6F14\u51FA\u3002"
    trigger: "\u64A4\u79BB\u4F1A\u8BAE\u540E\uFF0C\u4E3B\u89D2\u51B3\u5B9A\u5EF6\u7F13\u8680\u6D77\u4FB5\u8680\u3002"
    completion: "\u62A4\u536B\u81F3\u951A\u5B8C\u6210\uFF0C\u4E3B\u89D2\u9677\u5165\u865A\u5F31\u72B6\u6001\uFF0C\u5BF9\u8BDD\u540E\u5207\u81F321\u3002"
    interaction: "\u6768\u5E94\u9686\u4E3B\u63A7\u3001\u56FA\u5B9A\u9762\u677F\u7684\u6F14\u51FA\u6027\u8D28\u9632\u5FA1\u6218\uFF1B\u65E0\u9650\u602A\u7269\uFF0C\u575A\u6301N\u56DE\u5408\u80DC\u5229\u3002"
    staging: "\u6853\u7389\u9274\u521B\u5EFA\u5927\u951A\uFF1B\u6768\u5E94\u9686\u3001\u6797\u6EAA\u8FDB\u884C\u62A4\u536B\u3002"
    designNotes: "N\u503C\u3001\u56FA\u5B9A\u9762\u677F\u3001\u654C\u4EBA\u3001\u80FD\u529B\u52A8\u753B\u4E0E\u865A\u5F31\u540E\u5BF9\u8BDD\u5F85\u8865\uFF1B\u4E0D\u5047\u5B9A\u7ED9\u5165\u80CC\u5305\u4E00\u4E2A\u5DE8\u5927\u951A\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D265\u2014\u6B63\u6587\u6BB5\u843D271"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D265]\n\u64A4\u79BB\u524D\uFF0C\u6853\u7389\u9274\u51B3\u5B9A\u524D\u5F80\u8680\u6D77\u7554\uFF0C\u521B\u5EFA\u5927\u89C4\u6A21\u73B0\u5B9E\u7A33\u5B9A\u951A\u5EF6\u7F13\u8680\u6D77\u4FB5\u8680\uFF0C\u5E76\u8BF7\u6C42\u6797\u6EAA\uFF0C\u6768\u5E94\u9686\u968F\u540C\u524D\u5F80\u62A4\u536B\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D267]\n\u573A\u666F\uFF1A\u8680\u6D77\u6D77\u5CB8\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D269]\n\u4E8B\u4EF6\uFF1A\u4E3B\u89D2\u5F00\u59CB\u521B\u5EFA\u5927\u89C4\u6A21\u73B0\u5B9E\u7A33\u5B9A\u951A\uFF0C\u6768\u5E94\u9686\uFF0C\u6797\u6EAA\u8FDB\u884C\u62A4\u536B\u6218\uFF0C\u76F4\u5230\u4E3B\u89D2\u5B8C\u6210\u5EFA\u7ACB\uFF0C\u9677\u5165\u865A\u5F31\u72B6\u6001\uFF0C\u7ECF\u8FC7\u4E00\u6BB5\u5BF9\u8BDD\u540E\u753B\u9762\u76F4\u63A5\u5207\u6362\u81F321\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D271]\n\u8BF4\u660E\uFF1A\u6768\u5E94\u9686\u4E3A\u4E3B\u63A7\uFF0C\u6709\u56FA\u5B9A\u9762\u677F\uFF0C\u6F14\u51FA\u6027\u8D28\u7684\u9632\u5FA1\u6218\uFF08\u602A\u7269\u65E0\u9650\uFF0C\u575A\u6301N\u4E2A\u56DE\u5408\u80DC\u5229\uFF09"
