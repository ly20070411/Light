  - id: event-02
    eventNumber: 2
    title: "\u5BA3\u8BFB\u89C4\u5219\u4E0E\u53D6\u5F97\u73AF\u5883\u6570\u636E"
    route: "\u5171\u901A"
    kind: "\u4E3B\u7EBF\u4E8B\u4EF6"
    summary: "\u5168\u5458\u5728\u603B\u63A7\u5BA4\u96C6\u5408\uFF0C\u6853\u7389\u9274\u5BA3\u8BFB\u7AD9\u5185\u6CE8\u610F\u4E8B\u9879\u540E\u89E3\u6563\uFF0C\u518D\u67E5\u9605\u73AF\u5883\u76D1\u6D4B\u53F0\u5E76\u6536\u53D6\u6570\u636E\u8868\u3002"
    trigger: "\u8BA4\u77E5\u6D4B\u8BD5\u5B8C\u6210\u540E\u8FDB\u5165\u603B\u63A7\u5BA4\u3002"
    completion: "\u5B8C\u6210\u5BA3\u8BFB\u5E76\u6536\u96C6\u73AF\u5883\u6570\u636E\u6863\u6848\u3002"
    interaction: "\u6CE8\u610F\u4E8B\u9879\u7EC8\u7AEF \u2192 \u67E5\u9605\u5E76\u5BA3\u8BFB\uFF1B\u73AF\u5883\u76D1\u6D4B\u53F0
      \u2192 \u6536\u96C6\u73AF\u5883\u6570\u636E\u8868\u5165\u5305\u3002"
    staging: "\u89C4\u5219\u602A\u8C08\u5F0F\u5448\u73B0\uFF1B\u5168\u5458\u96C6\u5408\u540E\u89E3\u6563\u8FDB\u884C\u5165\u9A7B\u51C6\u5907\u3002"
    designNotes: "\u539F\u6587\u516D\u6761\u89C4\u5219\u5355\u5217\u4E3A\u89C4\u5219\u8D44\u6599\u3002\u8FD1\u5CB8\u5141\u8BB8\u505C\u7559\u7684n\u65F6\u8FB0\u4E3A\u5F85\u586B\u53C2\u6570\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D71\u2014\u6B63\u6587\u6BB5\u843D88"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D71]\n2.\u5168\u5458\u8FDB\u5165\u79D1\u8003\u7AD9\u603B\u63A7\u5BA4\uFF0C\u6853\u7389\u9274\u5F00\u59CB\u5BA3\u8BFB\u7AD9\u5185\u6CE8\u610F\u4E8B\u9879\uFF0C\u5BA3\u8BFB\u5B8C\u6BD5\u540E\uFF0C\u5168\u5458\u89E3\u6563\u8FDB\u884C\u5165\u9A7B\u51C6\u5907\u5DE5\u4F5C\uFF0C\u4E3B\u89D2\u524D\u5F80\u76D1\u6D4B\u53F0\u67E5\u9605\u73AF\u5883\u4FE1\u606F\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D73]\n\u573A\u666F\uFF1A4.\u603B\u63A7\u5BA4\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D75]\n\u9053\u5177\uFF1A7.\u73AF\u5883\u6570\u636E\u8868\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D77]\n\u4E8B\u4EF6\uFF1A\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D78]\n\xB7\u73A9\u5BB6\u67E5\u9605\u7EC8\u7AEF\u4E0A\u7684\u6CE8\u610F\u4E8B\u9879\uFF0C\u5E76\u5BA3\u8BFB\u7ED9\u6240\u6709\u4EBA\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D79]\n\xB7\u73A9\u5BB6\u524D\u5F80\u73AF\u5883\u76D1\u6D4B\u53F0\u6536\u96C6\u73AF\u5883\u6570\u636E\uFF0C\u5C06\u6570\u636E\u6863\u6848\u4F5C\u4E3A\u7269\u54C1\u6536\u5165\u80CC\u5305\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D81]\n\u8BF4\u660E\uFF1A\u4EE5\u89C4\u5219\u602A\u8C08\u7684\u65B9\u5F0F\u5448\u73B0\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D82]\n\u5305\u62EC\uFF1A\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D83]\n\u79D1\u8003\u7AD9\u5185\u90E8\u7EDD\u5BF9\u5B89\u5168\uFF0C\u4E0D\u4F1A\u51FA\u73B0\u4EFB\u4F55\u5E7B\u8C61\u6216\u8BA4\u77E5\u6C61\u67D3\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D84]\n\u4E0D\u5F97\u5728\u8680\u6D77\u8FD1\u5CB8\u9017\u7559\u8D85\u8FC7n\u65F6\u8FB0\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D85]\n\u79BB\u7AD9\u65F6\uFF0C\u8865\u6EE1\u6A21\u56E0\u5B9E\u9A8C\u5BA4\u50A8\u5B58\u7684\u5DE5\u4E1A\u606F\u58E4\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D86]\n\u961F\u53CB\u5411\u4F60\u63D0\u53CA\u4E0D\u5B58\u5728\u7684\u4EBA\u65F6\uFF0C\u76F8\u4FE1\u4ED6\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D87]\n\u79D1\u8003\u7AD9\u5185\u89C2\u6D4B\u5230\u6B8B\u5F71\u662F\u6B63\u5E38\u73B0\u8C61\uFF0C\u65E0\u89C6\u5B83\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D88]\n\u5411\u6B7B\u65B9\u751F"
