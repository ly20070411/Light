    eventNumber: 12
    title: "\u5E9F\u5F03\u79D1\u8003\u8239\u81EA\u7531\u63A2\u7D22"
    route: "\u5171\u901A"
    kind: "\u4E3B\u7EBF\u4E8B\u4EF6"
    summary: "\u5E38\u6708\u5BB9\u7528\u7EF3\u7D22\u5E2E\u52A9\u4F17\u4EBA\u4E0A\u7532\u677F\uFF0C\u56DB\u4EBA\u540C\u884C\u8FDB\u5165\u8239\u8231\u81EA\u7531\u63A2\u7D22\u3002"
    trigger: "\u9489\u951A\u540E\u767B\u8239\u3002"
    completion: "\u63A2\u7D22\u573A\u666F\u5E76\u627E\u5230\u8FDB\u5165\u8239\u957F\u5BA4\u7684\u5173\u952E\u6761\u4EF6\u3002"
    interaction: "\u7EF3\u7D22\u767B\u7532\u677F \u2192 \u8239\u8231\u6218\u6597\u3001\u5BC6\u5BA4\u3001\u9053\u5177\u4E0E\u89E3\u8C1C\u63A2\u7D22\u3002"
    staging: "\u524D\u4E00\u652F\u52D8\u6D4B\u961F\u7684\u5E9F\u5F03\u8239\u5B58\u5728\u5927\u91CF\u73B0\u5B9E\u7F3A\u5931\uFF1B\u53EF\u7528\u96EA\u82B1\u5C4F\u6216\u9A6C\u8D5B\u514B\u8499\u7248\u586B\u5145\u3002"
    designNotes: "\u672C\u6BB5\u662F\u672A\u5C55\u5F00\u7684\u63A2\u7D22\u6982\u8981\uFF0C\u602A\u7269\u3001\u5BC6\u5BA4\u3001\u5177\u4F53\u8C1C\u9898\u3001\u89E3\u7B54\u4E0E\u6389\u843D\u6E05\u5355\u5747\u5F85\u8865\u3002\u8239\u957F\u5BA4\u94A5\u5319\u5728\u4E0B\u4E00\u4E8B\u4EF6\u660E\u786E\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D191\u2014\u6B63\u6587\u6BB5\u843D197"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D191]\n\u5B89\u4FDD\u7528\u7EF3\u7D22\u4F7F\u4F17\u4EBA\u767B\u4E0A\u7532\u677F\uFF0C\u73A9\u5BB6\u53EF\u8FDB\u5165\u8239\u8231\u81EA\u7531\u63A2\u7D22\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D193]\n\u573A\u666F\uFF1A\u5E9F\u5F03\u79D1\u8003\u8239\u7532\u677F\uFF0C\u8239\u8231\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D195]\n\u4E8B\u4EF6\uFF1A\u56DB\u4EBA\u4E00\u8D77\u884C\u52A8\uFF0C\u5176\u4E2D\u5305\u542B\u5F88\u591A\u602A\uFF0C\u5BC6\u5BA4\u4E0E\u9053\u5177\uFF0C\u723D\u6253\u723D\u5403\u723D\u89E3\u5BC6\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D197]\n\u8BF4\u660E\uFF1A\u5E9F\u5F03\u79D1\u8003\u8239\u5C5E\u4E8E\u524D\u4E00\u652F\u52D8\u6D4B\u961F\uFF0C\u5B58\u5728\u5927\u91CF\u73B0\u5B9E\u7F3A\u5931\uFF0C\u53EF\u4EE5\u4F7F\u7528\u5927\u91CF\u96EA\u82B1\u5C4F\u6216\u9A6C\u8D5B\u514B\u8499\u7248\u586B\u5145\u573A\u666F\uFF0C\u540C\u65F6\u964D\u4F4E\u7F8E\u672F\u6210\u672C\uFF08\u964D\u5565\u554A\uFF0C\u7F8E\u672F\u8D44\u6E90\u6781\u5927\u4E30\u5BCC\u4E86\u90FD\uFF09"
