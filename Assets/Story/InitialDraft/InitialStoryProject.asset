    hexagram: "\u5927\u8FC7\u5366\u638C\u5366"
    notes: "\u9752\u9706\u53F8\u4E3A\u7F57\u5929\u6559\u7684\u6267\u884C\u90E8\uFF0C\u8D1F\u8D23\u76F4\u63A5\u6267\u884C\u52AB\u707E\u7684\u6536\u5BB9\u7EAF\u6218\u58EB\uFF0C\u6309\u6218\u6597\u4EBA\u5458\u8BBE\u8BA1\u6BD4\u5366\u8C61\u5F81\u8FC7\u5EA6\uFF0C\u7269\u6781\u5FC5\u53CD\uFF0C\u4EE5\u9AD8\u5927\u7684\u6811\u6728\u6216\u623F\u6881\u4E3A\u8C61\u5F81\u6811\u6728\u8FC7\u76DB\u800C\u8870\uFF0C\u6545\u6743\u80FD\u4E0E\u201C\u51CB\u4EA1\u201D\u6709\u5173\u80FD\u529B\u4E3A\u201C\u8FC7\u884D\u5316\u201D\uFF0C\u4F7F\u4E8B\u7269\u5FEB\u901F\u884D\u5316\u81F3\u8870\u4EA1\u72B6\u6001\n\u6574\u7406\u5907\u6CE8\uFF1A\u539F\u5907\u6CE8\u5199\u201C\u6BD4\u5366\u8C61\u5F81\u8FC7\u5EA6\u201D\uFF0C\u4EBA\u7269\u5366\u8C61\u5217\u4E3A\u5927\u8FC7\u5366\uFF1B\u5366\u8C61\u5B57\u6BB5\u6309\u4EBA\u7269\u5217\u4FDD\u7559\u5927\u8FC7\uFF0C\u539F\u6587\u672A\u6539\u3002"
    sourceText: "\u6768\u5E94\u9686 | \u7537 | \u6B21\u8981\u4EBA\u7269 | \u7F57\u5929\u6559
      | \u9752\u9706\u53F8\u534E\u6768\uFF08\u7279\u52E4\u961F\u961F\u957F\u804C\u4F4D\uFF09
      | \u5B89\u4FDD\u4EBA\u5458 | \u5927\u8FC7\u5366\u638C\u5366 | \u9752\u9706\u53F8\u4E3A\u7F57\u5929\u6559\u7684\u6267\u884C\u90E8\uFF0C\u8D1F\u8D23\u76F4\u63A5\u6267\u884C\u52AB\u707E\u7684\u6536\u5BB9\u7EAF\u6218\u58EB\uFF0C\u6309\u6218\u6597\u4EBA\u5458\u8BBE\u8BA1\u6BD4\u5366\u8C61\u5F81\u8FC7\u5EA6\uFF0C\u7269\u6781\u5FC5\u53CD\uFF0C\u4EE5\u9AD8\u5927\u7684\u6811\u6728\u6216\u623F\u6881\u4E3A\u8C61\u5F81\u6811\u6728\u8FC7\u76DB\u800C\u8870\uFF0C\u6545\u6743\u80FD\u4E0E\u201C\u51CB\u4EA1\u201D\u6709\u5173\u80FD\u529B\u4E3A\u201C\u8FC7\u884D\u5316\u201D\uFF0C\u4F7F\u4E8B\u7269\u5FEB\u901F\u884D\u5316\u81F3\u8870\u4EA1\u72B6\u6001"
