  - id: event-11
    eventNumber: 11
    title: "\u5165\u8239\u524D\u951A\u5B9A\u4E0E\u7075\u611F\u68C0\u5B9A"
    route: "\u5171\u901A"
    kind: "\u4E3B\u7EBF\u4E8B\u4EF6"
    summary: "\u4E3B\u89D2\u5929\u773C\u5BDF\u89C9\u8239\u8231\u8BA4\u77E5\u5371\u5BB3\uFF0C\u62E6\u4F4F\u540C\u884C\u8005\u5E76\u89E3\u91CA\uFF0C\u4E3A\u4F17\u4EBA\u521B\u5EFA\u951A\uFF1B\u6781\u4F4E\u6210\u529F\u7387\u7075\u611F\u68C0\u5B9A\u53EF\u8BC6\u522B\u9006\u6A21\u56E0\u3002"
    trigger: "\u56DB\u4EBA\u51C6\u5907\u8FDB\u5165\u8239\u8231\u65F6\u3002"
    completion: "\u4E3A\u4F17\u4EBA\u9489\u951A\u5E76\u5B8C\u6210\u7075\u611F\u68C0\u5B9A\u3002"
    interaction: "\u505C\u6B65\u62E6\u4EBA \u2192 \u89E3\u91CA \u2192 \u951A\u5B9A
      \u2192 \u7075\u611F\u68C0\u5B9A\u3002"
    staging: "\u6743\u80FD\u951A\u5B9A\u8BA4\u77E5\u7684\u52A8\u753B\u5C5E\u4E8E\u6B21\u8981\u8868\u73B0\u9700\u6C42\u3002"
    designNotes: "\u7075\u611F\u5931\u8D25\u5224\u65AD\u4E3A\u8680\u6D77\u6C34\u6CC4\u9732\uFF0C\u6210\u529F\u610F\u8BC6\u5230\u4E0E\u9006\u6A21\u56E0\u6709\u5173\u3002\u6B63\u6587\u6CA1\u660E\u786E\u6B64\u68C0\u5B9A\u7ED9\u9690\u85CF\u503C\uFF0C\u56E0\u6B64\u9690\u85CF\u503C\u4E0D\u589E\u52A0\u3002\u6210\u529F\u7387\u6570\u503C\u5F85\u8865\u3002\u951A\u5B9A\u4E0D\u81EA\u52A8\u6D88\u8017\u9053\u51773\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D182\u2014\u6B63\u6587\u6BB5\u843D188"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D182]\n\u4E3B\u89D2\u5E26\u7740\u5E38\u6708\u5BB9\uFF0C\u5510\u6666\uFF0C\u865E\u9752\u8FDB\u5165\u8239\u8231\u65F6\uFF0C\u4E3B\u89D2\u7684\u5929\u773C\u5BDF\u89C9\u5230\u8239\u8231\u5185\u7684\u8BA4\u77E5\u5371\u5BB3\uFF0C\u4E3A\u4F17\u4EBA\u521B\u5EFA\u4E86\u951A\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D184]\n\u573A\u666F\uFF1A\u6401\u6D45\u79D1\u8003\u8239\u7684\u6D77\u5CB8\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D186]\n\u4E8B\u4EF6\uFF1A\u4E3B\u89D2\u8FDB\u5165\u8239\u8231\u65F6\u505C\u6B65\u5E76\u62E6\u4F4F\u4F17\u4EBA\uFF0C\u89E3\u91CA\u540E\u4E3A\u4F17\u4EBA\u521B\u5EFA\u4E86\u951A\uFF0C\u5E76\u4E14\u8FC7\u4E00\u4E2A\u7075\u611F\uFF08\u6210\u529F\u7387\u6781\u4F4E\uFF09\u672A\u6210\u529F\u5224\u65AD\u4E3A\u8680\u6D77\u6C34\u6CC4\u9732\uFF0C\u6210\u529F\u5219\u610F\u8BC6\u5230\u4E0E\u9006\u6A21\u56E0\u6709\u5173\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D188]\n\u8BF4\u660E\uFF1A\u8BBE\u8BA1\u4E3B\u89D2\u4F7F\u7528\u6743\u80FD\u951A\u5B9A\u8BA4\u77E5\u7684\u52A8\u753B\uFF08\u901A\u4FD7\u6765\u8BF4\u662F\u9501san\u503C\uFF09\uFF08\u6B21\u8981\uFF09"
