    designNotes: "\u7B56\u5212\u771F\u76F8\uFF1A\u8C2D\u793F\u961F\u4F0D\u5168\u5458\u88AB\u62B9\u6D88\u3002\u539F\u6587\u8981\u6C42\u6B64\u4FE1\u606F\u5728NE\u5185\u4E0D\u5411\u73A9\u5BB6\u660E\u793A\uFF0C\u5B58\u4E3A\u79D8\u5BC6\u8BBE\u5B9A\uFF0C\u4E0D\u653E\u8FDB\u73A9\u5BB6\u53F0\u8BCD\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D273\u2014\u6B63\u6587\u6BB5\u843D279"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D273]\n\u5168\u5458\u767B\u8239\u64A4\u79BB\uFF0C\u79BB\u5F00\u524D\uFF0C\u4E3B\u89D2\u56DE\u5934\u770B\u89C1\u795E\u79D8\u5F71\u5B50\uFF08\u8C2D\u793F\uFF09\u5316\u4F5C\u7C92\u5B50\u6D88\u6563\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D275]\n\u573A\u666F\uFF1A\u79D1\u8003\u7AD9\u9644\u8FD1\uFF08\u7801\u5934\u4E0A\uFF09\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D277]\n\u4E8B\u4EF6\uFF1A\u64AD\u653E\u52A8\u753B\uFF0C\u961F\u5458\u9646\u7EED\u901A\u8FC7\u8237\u68AF\u767B\u4E0A\u79D1\u8003\u8239\uFF0C\u4E3B\u89D2\u6700\u540E\u4E00\u4E2A\u4E0A\u8239\uFF0C\u6765\u5230\u7801\u5934\u53E3\u65F6\uFF0C\u4E3B\u89D2\u56DE\u5934\u770B\u5230\u4E86\u8C2D\u793F\u7684\u5F71\u5B50\u5316\u4F5C\u7C92\u5B50\u6D88\u6563\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D279]\n\u8BF4\u660E\uFF1ANE\u7ED3\u5C40\u6700\u540E\u7684\u753B\u9762\uFF0C\u4E3B\u89D2\u7684\u79D1\u8003\u961F\u53D7\u9006\u6A21\u56E0\u5F71\u54CD\u672A\u80FD\u53D1\u73B0\u8C2D\u793F\u7684\u961F\u4F0D\uFF0C\u56E0\u6B64\u8C2D\u793F\u961F\u4F0D\u5168\u5458\u88AB\u62B9\u6D88\uFF08\u600E\u4E48\u8FD9\u4E2A\u66F4\u50CFBE\uFF09\u4E0D\u8FC7\u8FD9\u4E2A\u4FE1\u606F\u5728\u8BE5\u7ED3\u5C40\u5185\u4E0D\u5411\u73A9\u5BB6\u660E\u793A\uFF0C\u6240\u4EE5\u628A\u6C14\u6C1B\u70D8\u6258\u7684\u4F24\u611F\u4E00\u4E9B"
