    designNotes: "\u7B2C19\u201421\u4E8B\u4EF6\u5728\u6B63\u6587\u672A\u76F4\u63A5\u6807\u53F7\uFF0C\u6309\u987A\u5E8F\u53CA\u6BB5\u843D269\u201C\u5207\u6362\u81F321\u201D\u6574\u7406\u3002\u4F1A\u8BAE\u5B8C\u6574\u5BF9\u8BDD\u4E0E\u8868\u51B3\u5448\u73B0\u5F85\u8865\u3002"
