    notes: "\u539F\u6587\u89C4\u5219\uFF0C\u5F85\u914D\u5BA3\u8BFB\u6F14\u51FA\u3002"
  - id: rule-station-02
    title: "\u7AD9\u5185\u6CE8\u610F\u4E8B\u9879 2"
    text: "\u4E0D\u5F97\u5728\u8680\u6D77\u8FD1\u5CB8\u9017\u7559\u8D85\u8FC7n\u65F6\u8FB0"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D84"
    notes: "\u539F\u6587\u89C4\u5219\uFF0C\u5F85\u914D\u5BA3\u8BFB\u6F14\u51FA\u3002n\u65F6\u8FB0\u4E3A\u5F85\u586B\u53C2\u6570\u3002"
  - id: rule-station-03
    title: "\u7AD9\u5185\u6CE8\u610F\u4E8B\u9879 3"
    text: "\u79BB\u7AD9\u65F6\uFF0C\u8865\u6EE1\u6A21\u56E0\u5B9E\u9A8C\u5BA4\u50A8\u5B58\u7684\u5DE5\u4E1A\u606F\u58E4"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D85"
    notes: "\u539F\u6587\u89C4\u5219\uFF0C\u5F85\u914D\u5BA3\u8BFB\u6F14\u51FA\u3002"
  - id: rule-station-04
    title: "\u7AD9\u5185\u6CE8\u610F\u4E8B\u9879 4"
    text: "\u961F\u53CB\u5411\u4F60\u63D0\u53CA\u4E0D\u5B58\u5728\u7684\u4EBA\u65F6\uFF0C\u76F8\u4FE1\u4ED6"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D86"
    notes: "\u539F\u6587\u89C4\u5219\uFF0C\u5F85\u914D\u5BA3\u8BFB\u6F14\u51FA\u3002"
  - id: rule-station-05
    title: "\u7AD9\u5185\u6CE8\u610F\u4E8B\u9879 5"
    text: "\u79D1\u8003\u7AD9\u5185\u89C2\u6D4B\u5230\u6B8B\u5F71\u662F\u6B63\u5E38\u73B0\u8C61\uFF0C\u65E0\u89C6\u5B83"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D87"
    notes: "\u539F\u6587\u89C4\u5219\uFF0C\u5F85\u914D\u5BA3\u8BFB\u6F14\u51FA\u3002"
  - id: rule-station-06
    title: "\u7AD9\u5185\u6CE8\u610F\u4E8B\u9879 6"
    text: "\u5411\u6B7B\u65B9\u751F"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D88"
    notes: "\u539F\u6587\u89C4\u5219\uFF0C\u5F85\u914D\u5BA3\u8BFB\u6F14\u51FA\u3002"
  - id: rule-hidden-sources
    title: "\u56DB\u4E2A\u4E3B\u7EBF\u9690\u85CF\u503C\u4E8B\u4EF6"
    text: "\u5B8C\u6210\u4E09\u6B21\u8680\u6D77\u91C7\u6837 +1\uFF1B\u8BA9\u6797\u6EAA\u7EE7\u7EED\u4FEE\u590D\u6570\u636E\u5E93
      +1\uFF1B\u8BFB\u53D6\u8239\u5458\u8BB0\u5FC6\u5F97\u5230\u4FE1\u606F\u951A
      +1\uFF1B\u8FFD\u51FB\u5E76\u53D6\u5F97\u7F57\u5929\u6559\u5236\u5F0F\u73B0\u5B9E\u7A33\u5B9A\u951A
      +1\u3002\u4E3B\u7EBF\u53EF\u786E\u8BA4\u6700\u5927\u503C\u4E3A4\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D130\uFF1B\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D158\uFF1B\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D213\uFF1B\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D236\uFF1B\u672C\u6B21\u5BF9\u8BDD/2026-10-08\u7528\u6237\u786E\u8BA4"
    notes: "\u8BFB\u53D6\u8BB0\u5FC6\u9879\u7531\u7528\u6237\u786E\u8BA4\uFF1B\u5176\u4F59\u6765\u81EA\u6B63\u6587\u3002\u6781\u4F4E\u6210\u529F\u7387\u7075\u611F\u68C0\u5B9A\u672A\u660E\u793A\u52A0\u503C\uFF0C\u4E0D\u64C5\u81EA\u589E\u52A0\u3002"
  - id: rule-hidden-threshold
    title: "\u7B2C\u4E09\u65E5\u9690\u85CF\u503C\u8DEF\u7EBF\u9608\u503C\uFF08\u5DF2\u786E\u8BA4\uFF09"
    text: "\u5267\u60C5\u9690\u85CF\u503C\u22653\uFF1A\u8FDB\u5165HE/TE\uFF1B\u4E3A0\uFF1A\u8FDB\u5165NE\uFF1B\u4E3A1\u62162\uFF1A\u73A9\u5BB6\u53EF\u9009\u62E9NE\u64A4\u79BB\u6216BE\u7EE7\u7EED\u8C03\u67E5\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D53\uFF1B\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D246\u2014\u6B63\u6587\u6BB5\u843D249\uFF1B\u672C\u6B21\u5BF9\u8BDD/2026-10-08\u7528\u6237\u786E\u8BA4"
    notes: "\u539F\u6587\u201C\u5927\u4E8E3\u201D\u7684\u51B2\u7A81\u5DF2\u6309\u7528\u6237\u786E\u8BA4\u89E3\u51B3\uFF1BHE/TE\u8FDB\u4E00\u6B65\u5206\u6D41\u5F85\u8865\u3002"
  - id: rule-extra-hidden
    title: "\u989D\u5916\u9690\u85CF\u503C\uFF08\u6B21\u8981\uFF0C\u672A\u5C55\u5F00\uFF09"
    text: "\u989D\u5916\u9690\u85CF\u503C\uFF1A\u5728\u573A\u666F\u4E2D\u5B8C\u6210\u6210\u529F\u7387\u6781\u4F4E\u7684\u68C0\u5B9A\u6216\u8F83\u96BE\u7684\u89E3\u5BC6\uFF0C\u83B7\u5F97\u989D\u5916\u7EBF\u7D22\u79EF\u7D2F\u9690\u85CF\u503C\uFF08\u6B21\u8981\uFF09"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D54"
    notes: "\u53EA\u5B58\u8BBE\u8BA1\u89C4\u5219\u3002\u5177\u4F53\u989D\u5916\u7EBF\u7D22\u3001\u8C1C\u9898\u3001\u6570\u503C\u4E0E\u53D1\u653E\u6761\u4EF6\u5C1A\u672A\u7ED9\u51FA\u3002"
  lore:
  - id: lore-sea
    title: "\u8680\u6D77\u4E0E\u865A\u65E0\u6548\u5E94"
    text: "\u592A\u884D\u9646\u6570\u767E\u6D77\u91CC\u5916\uFF0C\u5B58\u5728\u7740\u5EF6\u7EF5\u6570\u56DB\u4E07\u91CC\uFF0C\u7531\u7279\u6B8A\u7269\u8D28\u7B51\u6210\uFF0C\u5C06\u5185\u6D77\u5408\u56F4\u8D77\u6765\u7684\u5824\u575D\uFF0C\u88AB\u79F0\u4E3A\u201C\u7EE5\u6D77\u5830\u201D\n\n\u4F20\u8BF4\u516D\u795E\u521B\u4E16\u4E4B\u65F6\uFF0C\u865A\u795E\u7384\u6B66\u56E0\u6DF7\u6C8C\u800C\u9668\u843D\uFF0C\u4E8E\u662F\u7075\u795E\u52FE\u9648\u8D50\u5148\u6C11\u5366\u8C61\uFF0C\u4EE4\u5176\u7384\u6B66\u7684\u6B8B\u8EAF\u6CC4\u9732\u51FA\u7684\u865A\u65E0\u5316\u4E3A\u6D77\u6C34\uFF0C\u518D\u7B51\u8D77\u957F\u5824\uFF0C\u963B\u6321\u7384\u6B66\u6B8B\u8EAF\u7684\u4FB5\u8680\u3002\n\n\u7ECF\u5F53\u4EE3\u5B66\u8005\u7684\u7814\u7A76\uFF0C\u7269\u4F53\u957F\u671F\u5904\u4E8E\u8680\u6D77\u6C34\u7684\u6C1B\u56F4\u4E2D\u4F1A\u88AB\u9010\u6E10\u201C\u62B9\u6D88\u201D\u2014\u2014\u4E0D\u4EC5\u662F\u7269\u8D28\u4E0A\u7684\u9500\u8680\uFF0C\u8FD8\u5F80\u5F80\u4F34\u968F\u7740\u8BA4\u77E5\u610F\u4E49\u4E0A\u7684\u6D88\u9664\u3002\u53D7\u5230\u8680\u6D77\u6C34\u5F71\u54CD\u7684\u7269\u8D28\u4F1A\u96BE\u4EE5\u88AB\u611F\u5B98\u4E0E\u4EEA\u5668\u89C2\u6D4B\uFF0C\u751A\u81F3\u6709\u7814\u7A76\u5458\u8868\u793A\u201C\u4E0D\u77E5\u9053\u81EA\u5DF1\u5728\u8FDB\u884C\u4EC0\u4E48\u7814\u7A76\u201D\u3002\u5BF9\u4E8E\u53D7\u8BD5\u7684\u4E01\u7EA7\u4EBA\u5458\u4F1A\u51FA\u73B0\u610F\u5FD7\u6D88\u6C89\uFF0C\u8BB0\u5FC6\u7F3A\u5931\uFF0C\u8BA4\u77E5\u635F\u5BB3\u7B49\u73B0\u8C61\u3002\n\n\u8FD9\u79CD\u73B0\u8C61\u6700\u7EC8\u88AB\u5F52\u7ED3\u4E3A\u201C\u865A\u65E0\u7684\u7EAF\u7CB9\u6982\u5FF5\u8D8B\u540C\u201D\uFF0C\u7B80\u79F0\u201C\u865A\u65E0\u6548\u5E94\u201D\u8FDB\u4E00\u6B65\u5370\u8BC1\u4E86\u201C\u8680\u6D77\u7531\u865A\u795E\u4EA7\u751F\u201D\u7684\u89C2\u70B9"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D20\u2014\u6B63\u6587\u6BB5\u843D26"
    secret: 0
  - id: lore-dam
    title: "\u7EE5\u6D77\u5830\u4E0E\u606F\u58E4"
    text: "\u6784\u6210\u7EE5\u6D77\u5830\u7684\u7279\u6B8A\u7269\u8D28\u88AB\u79F0\u4E3A\u201C\u606F\u58E4\u201D\uFF0C\u606F\u58E4\u5177\u6709\u81EA\u6211\u4FEE\u590D\u4E0E\u5B9A\u4E49\u7684\u80FD\u529B\uFF0C\u5177\u6709\u5F3A\u5927\u73B0\u5B9E\u7A33\u5B9A\u529F\u80FD"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D30"
    secret: 0
  - id: lore-dam-truth
    title: "\u606F\u58E4\u4E2D\u7684\u4EBA\u7C7B\u610F\u8BC6\uFF08\u79D8\u5BC6\uFF09"
    text: "\u606F\u58E4\u5B9E\u8D28\u4E3A\u5BC4\u5BBF\u4E86\u4EBA\u7C7B\u610F\u8BC6\u7684\u7279\u6B8A\u7269\u8D28\u3002\u8680\u6D77\u8513\u5EF6\u65F6\uFF0C\u5927\u91CF\u4EBA\u7C7B\u5728\u5366\u4E3B\u7684\u5F15\u5BFC\u4E0B\u628A\u81EA\u5DF1\u7684\u7CBE\u795E\u878D\u5165\u571F\u58E4\uFF0C\u5EFA\u7ACB\u4E86\u7EE5\u6D77\u5830\u3002\u606F\u58E4\u4E2D\u7684\u4EBA\u7C7B\u610F\u8BC6\u901A\u8FC7\u89C2\u6D4B\u4E0E\u5B9A\u4E49\u73B0\u5B9E\u7684\u65B9\u5F0F\u5BF9\u6297\u8680\u6D77\u7684\u865A\u65E0\u6548\u5E94"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D32"
    secret: 1
  - id: lore-memes
    title: "\u6A21\u56E0\u3001\u9006\u6A21\u56E0\u4E0E\u5BF9\u6297\u539F\u5219"
    text: "\u6545\u4E8B\u6CBF\u7528scp\u5BF9\u6A21\u56E0\uFF0C\u9006\u6A21\u56E0\u7684\u8BBE\u5B9A\uFF0C\u5C06boss\u8BBE\u5B9A\u4E3A\u53EF\u4EE5\u62B9\u6D88\u4EBA\u7C7B\u5B58\u5728\u7684\u9006\u6A21\u56E0\u5A01\u80C1\uFF0C\u5E76\u9075\u5FAA\u201C\u80FD\u6740\u6B7B\u7406\u5FF5\u7684\u53EA\u6709\u66F4\u597D\u7684\u7406\u5FF5\u201D\u7684\u539F\u5219"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D34\u2014\u6B63\u6587\u6BB5\u843D37"
    secret: 0
  - id: lore-mission
    title: "\u6551\u63F4\u4EFB\u52A1\u771F\u5B9E\u80CC\u666F\uFF08\u79D8\u5BC6\uFF09"
    text: "\u4E3A\u4E86\u68C0\u6D4B\u7EE5\u6D77\u5830\u7684\u72B6\u6001\uFF0C\u84EC\u83B1\u9986\u6BCF\u9694\u4E00\u5B9A\u65F6\u95F4\u4F1A\u6D3E\u9063\u79D1\u8003\u8239\uFF0C\u7531\u5366\u4E3B\u9886\u5BFC\uFF0C\u5BF9\u7EE5\u6D77\u5830\u8FDB\u884C\u4E3A\u671F\u6570\u5E74\u7684\u52D8\u5BDF\u4F5C\u4E1A\uFF0C\u7136\u800C\u7531\u8403\u5366\u5366\u4E3B\u8C2D\u793F\u9886\u5BFC\u7684\uFF0C\u79D1\u8003\u961F\u5728\u7EE5\u6D77\u5830\u25A1\u25A1\u6BB5\u5931\u53BB\u4E86\u8054\u7CFB\u3002\u4E8E\u662F\u84EC\u83B1\u9986\u5DE8\u5B50\u59D4\u6258\u7F57\u5929\u6559\u60AC\u9274\u53F8\u638C\u9274\uFF0C\u6052\u5366\u5366\u4E3B\u6853\u7389\u9274\u7EC4\u7EC7\u7279\u522B\u6551\u63F4\u884C\u52A8\uFF0C\u524D\u5F80\u7EE5\u6D77\u5830\u25A1\u25A1\u6BB5\u641C\u5BFB\u8C2D\u793F\u4E0E\u5176\u8239\u961F\u7684\u8E2A\u8FF9\n\n\u8C2D\u793F\u5E26\u9886\u7684\u79D1\u8003\u961F\u5728\u7EE5\u6D77\u5830\u906D\u9047\u9006\u6A21\u56E0\u52AB\u707E\u3002\u4E3A\u4FDD\u62A4\u961F\u5458\uFF0C\u8C2D\u793F\u542F\u7528\u79D1\u8003\u7AD9\u5185\u50A8\u5907\u7684\u6A21\u56E0\u63A9\u4F53\uFF0C\u6682\u65F6\u62B9\u6D88\u6574\u652F\u52D8\u5BDF\u961F\u7684\u5B58\u5728\uFF0C\u5E76\u5728\u8FD9\u4E00\u8FC7\u7A0B\u4E2D\u53D1\u73B0\u4E86\u7EE5\u6D77\u5830\u7684\u771F\u76F8\u3002\u6853\u7389\u9274\u7684\u961F\u4F0D\u5230\u6765\u65F6\uFF0C\u901A\u8FC7\u9690\u79D8\u65B9\u5F0F\u5F15\u5BFC\u6853\u7389\u9274\u7684\u961F\u4F0D\u8FDB\u884C\u53CD\u51FB"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D41\u2014\u6B63\u6587\u6BB5\u843D43"
    secret: 1
  - id: lore-blocked-mission
    title: "\u4EFB\u52A1\u76EE\u6807\u88AB\u5C4F\u853D\uFF08\u79D8\u5BC6\uFF09"
    text: "\u7531\u4E8E\u524D\u4E00\u652F\u79D1\u8003\u961F\u5904\u4E8E\u6A21\u56E0\u63A9\u4F53\uFF0C\u4E3B\u89D2\u961F\u4F0D\u5728\u767B\u9646\u65F6\u88AB\u5C4F\u853D\u4E86\u201C\u672C\u6B21\u4EFB\u52A1\u4EE5\u641C\u6551\u4E3A\u76EE\u6807\u201D\u7684\u8BA4\u77E5\uFF0C\u9700\u8981\u73A9\u5BB6\u53D1\u73B0\u573A\u666F\u4E2D\u7684\u4E0D\u534F\u8C03\u4E4B\u5904\uFF0C\u79EF\u7D2F\u9690\u85CF\u503C\uFF0C\u786E\u4FDD\u5728\u7B2C\u4E09\u65E5\u665A\u4E0A\u8FBE\u5230\u4E00\u5B9A\u7684\u9690\u85CF\u503C\uFF0C\u624D\u80FD\u89E6\u53D1HE"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D50"
    secret: 1
  - id: lore-ne-truth
    title: "NE\u5E55\u540E\u7ED3\u679C\uFF08\u4E0D\u5411\u73A9\u5BB6\u660E\u793A\uFF09"
    text: "\u8BF4\u660E\uFF1ANE\u7ED3\u5C40\u6700\u540E\u7684\u753B\u9762\uFF0C\u4E3B\u89D2\u7684\u79D1\u8003\u961F\u53D7\u9006\u6A21\u56E0\u5F71\u54CD\u672A\u80FD\u53D1\u73B0\u8C2D\u793F\u7684\u961F\u4F0D\uFF0C\u56E0\u6B64\u8C2D\u793F\u961F\u4F0D\u5168\u5458\u88AB\u62B9\u6D88\uFF08\u600E\u4E48\u8FD9\u4E2A\u66F4\u50CFBE\uFF09\u4E0D\u8FC7\u8FD9\u4E2A\u4FE1\u606F\u5728\u8BE5\u7ED3\u5C40\u5185\u4E0D\u5411\u73A9\u5BB6\u660E\u793A\uFF0C\u6240\u4EE5\u628A\u6C14\u6C1B\u70D8\u6258\u7684\u4F24\u611F\u4E00\u4E9B"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D279"
    secret: 1
  issues:
  - id: issue-threshold
    title: "\u7B2C\u4E09\u65E5\u22653\u9608\u503C\u51B2\u7A81"
    detail: "\u603B\u5219\u5199\u22653\uFF0C\u4E8B\u4EF618\u5199>3\u4E14\u9057\u6F0F\u6070\u597D3\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D53\uFF1B\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D247"
    status: "\u5DF2\u786E\u8BA4"
    resolution: "\u63092026-10-08\u7528\u6237\u786E\u8BA4\uFF1A\u9690\u85CF\u503C\u22653\u8FDB\u5165HE/TE\u3002"
  - id: issue-fourth-hidden
    title: "\u7B2C\u56DB\u4E2A\u4E3B\u7EBF\u9690\u85CF\u503C\u6765\u6E90"
    detail: "\u603B\u5219\u5199\u56DB\u4E2A\u4E8B\u4EF6\uFF0C\u6B63\u6587\u53EA\u6709\u4E09\u5904\u76F4\u63A5\u5199+1\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D53\uFF1B\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D213"
    status: "\u5DF2\u786E\u8BA4"
    resolution: "\u63092026-10-08\u7528\u6237\u786E\u8BA4\uFF1A\u8BFB\u53D6\u8239\u5458\u8BB0\u5FC6\u83B7\u5F97\u4FE1\u606F\u951A\u65F6+1\u3002"
  - id: issue-numbering
    title: "\u7F3A\u7701\u4E8B\u4EF6\u7F16\u53F7\u7684\u6574\u7406"
    detail: "\u6B63\u6587\u53EA\u67091\u30012\u30013\u300110\u76F4\u63A5\u5199\u4E86\u7F16\u53F7\uFF0C\u5176\u4ED6\u6309\u65E5\u7A0B\u987A\u5E8F\u6574\u7406\u4E3A4\u20149\u300111\u201421\uFF1B269\u6BB5\u76F4\u63A5\u5F15\u7528\u4E8B\u4EF621\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D60\u2014\u6B63\u6587\u6BB5\u843D279"
    status: "\u6574\u7406\u8BF4\u660E"
    resolution: "Day1 1\u20144\uFF1BDay2 5\u20149\uFF1BDay3 10\u201418\uFF1BNE Day4
      19\u201421\u3002\u4E0D\u6539\u53D8\u539F\u6587\u987A\u5E8F\u3002"
  - id: issue-test-dialogue
    title: "\u8BA4\u77E5\u6D4B\u8BD5\u9898\u4E0E\u5B8C\u6574\u5BF9\u8BDD\u672A\u63D0\u4F9B"
    detail: "\u539F\u7A3F\u53EA\u6709\u4E8B\u4EF6\u6982\u8981\uFF0C\u7F3A\u5C11\u8BA4\u77E5\u6D4B\u8BD5\u9898\u3001\u9009\u9879\u3001\u68C0\u5B9A\u53CD\u9988\u53CA\u7EDD\u5927\u591A\u6570\u5B8C\u6574\u5BF9\u8BDD\u3002\u6240\u6709\u8282\u70B9lines\u4FDD\u6301\u7A7A\uFF0C\u53EA\u6709\u539F\u6587\u552F\u4E00\u53F0\u8BCD\u5B58\u5165\u4E8B\u4EF614\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D60\u2014\u6B63\u6587\u6BB5\u843D279"
    status: "\u5F85\u8865"
    resolution: 
  - id: issue-rule-time
    title: "\u8FD1\u5CB8\u505C\u7559\u65F6\u95F4\u5F85\u586B"
    detail: "\u89C4\u5219\u5199\u4E0D\u5F97\u5728\u8680\u6D77\u8FD1\u5CB8\u9017\u7559\u8D85\u8FC7n\u65F6\u8FB0\uFF0C\u5177\u4F53n\u672A\u63D0\u4F9B\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D84"
