    designNotes: "\u8239\u5458\u5B9E\u9645\u662F\u524D\u79D1\u8003\u961F\u7559\u5B88\u8239\u4E0A\u7684\u961F\u5458\u3002\u8BFB\u53D6\u8BB0\u5FC6+1\u4E3A\u672C\u6B21\u7528\u6237\u660E\u786E\u786E\u8BA4\u7684\u7B2C\u56DB\u4E2A\u4E3B\u7EBF\u9690\u85CF\u503C\u4E8B\u4EF6\u3002\u539F\u6587\u552F\u4E00\u53F0\u8BCD\u7684\u8BF4\u8BDD\u4EBA\u672A\u6807\u660E\uFF0C\u4FDD\u7559\u5F85\u786E\u8BA4\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D209\u2014\u6B63\u6587\u6BB5\u843D214"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D209]\n\u51FB\u5012\u626D\u66F2\u751F\u7269\u540E\uFF0C\u751F\u7269\u6062\u590D\u5FAE\u5F31\u610F\u8BC6\uFF0C\u8868\u660E\u81EA\u5DF1\u662F\u8FD9\u8258\u8239\u7684\u8239\u5458\uFF08\u5B9E\u9645\u662F\u524D\u4E00\u652F\u79D1\u8003\u961F\u7559\u5B88\u79D1\u8003\u8239\u7684\u961F\u5458\uFF09\uFF0C\u5B58\u5728\u88AB\u626D\u66F2\u53D8\u6210\u602A\u7269\uFF0C\u8BF7\u6C42\u4E3B\u89D2\u4E86\u7ED3\u4ED6\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D211]\n\u573A\u666F\uFF1A\u8239\u957F\u5BA4\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D213]\n\u4E8B\u4EF6\uFF1A\u4E3B\u89D2\u53EF\u4EE5\u9009\u62E9\u5728\u4ED6\u8111\u4E2D\u79CD\u4E0B\u4FE1\u606F\u951A\u6536\u96C6\u5176\u8111\u4E2D\u8BB0\u5FC6\uFF0C\u83B7\u5F97\u50A8\u5B58\u8BB0\u5FC6\u7684\u4FE1\u606F\u951A\uFF0C\u4F46\u4ED6\u4F1A\u75DB\u82E6\u6B7B\u53BB\uFF0C\u201C\u4E0D\u5FC5\u81EA\u8D23\uFF0C\u5366\u4E3B\u9601\u4E0B\uFF0C\u5982\u679C\u5B58\u5728\u626D\u66F2\u7684\u662F\u6211\uFF0C\u4E5F\u4F1A\u5E0C\u671B\u60A8\u505A\u51FA\u8FD9\u6837\u7684\u6289\u62E9\u201D\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D214]\n\u6216\u8005\u51B3\u5B9A\u8BA9\u4ED6\u89E3\u8131\uFF0C\u83B7\u5F97\u989D\u5916\u9053\u5177"
