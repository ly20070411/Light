    interaction: "\u603B\u63A7\u5BA4\u6768\u5E94\u9686\u62A5\u544A \u2192 \u4ED3\u50A8\u533A\u5510\u6666\u88C5\u5907\u516D\u9009\u4E8C
      \u2192 \u9489\u951A\u3002"
    staging: 
    designNotes: "\u516D\u4EF6\u88C5\u5907\u53EA\u6709\u5019\u9009\u69FD\u5360\u4F4D\uFF0C\u540D\u79F0\u3001\u5C5E\u6027\u4E0E\u9009\u62E9\u6587\u6848\u5F85\u8865\uFF1B\u9489\u951A\u4E3A\u80FD\u529B\u884C\u4E3A\uFF0C\u4E0D\u5047\u5B9A\u6D88\u8017\u7269\u54C13\u3002\u539F\u6587\u201C\u4E3B\u63A7\u5BA4\u201D\u5F52\u5E76\u603B\u63A7\u5BA4\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D216\u2014\u6B63\u6587\u6BB5\u843D222"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D216]\n\u56DB\u4EBA\u56DE\u5F52\uFF0C\u63A5\u5230\u6768\u5E94\u9686\u62A5\u544A\uFF0C\u56E0\u4E3A\u8680\u6D77\u4FB5\u8680\u52A0\u5267\uFF0C\u7EE5\u6D77\u5830\u6E38\u8361\u52AB\u707E\u6709\u5411\u5185\u6D77\u7554\u8FC1\u5F99\u7684\u8D8B\u52BF\uFF0C\u51C6\u5907\u5E94\u5BF9\u602A\u6D77\u51B2\u51FB\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D218]\n\u573A\u666F\uFF1A\u4E3B\u63A7\u5BA4\uFF0C\u4ED3\u50A8\u533A\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D220]\n\u4E8B\u4EF6\uFF1A\u4E3B\u63A7\u5BA4\u4E0E\u6768\u5E94\u9686\u4EA4\u8C08\uFF0C\u5F97\u77E5\u52AB\u707E\u4FB5\u88AD\uFF0C\u524D\u5F80\u4ED3\u50A8\u533A\u627E\u5510\u6666\u9886\u53D6\u88C5\u5907\uFF08\u516D\u9009\u4E8C\uFF09\u5E76\u4E3A\u6768\u5E94\u9686\u9489\u951A\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D222]\n\u8BF4\u660E\uFF1A\u5927\u6218\u4E4B\u524D\uFF0C\u5FC5\u6709\u8865\u7ED9"
