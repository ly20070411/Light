  rules:
  - id: rule-station-01
    title: "\u7AD9\u5185\u6CE8\u610F\u4E8B\u9879 1"
    text: "\u79D1\u8003\u7AD9\u5185\u90E8\u7EDD\u5BF9\u5B89\u5168\uFF0C\u4E0D\u4F1A\u51FA\u73B0\u4EFB\u4F55\u5E7B\u8C61\u6216\u8BA4\u77E5\u6C61\u67D3"
