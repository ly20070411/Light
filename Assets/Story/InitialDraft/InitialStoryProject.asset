    staging: "\u7F13\u51B2\u95F4\u5185\u5C4F\u5E55\u663E\u793A\u6D4B\u8BD5\u95EE\u9898\u548C\u9009\u9879\uFF1B\u5177\u4F53\u95EE\u9898\u4E0E\u7B54\u6848\u6587\u6848\u5F85\u8865\u3002"
    designNotes: "\u6CBF\u7528\u65B0\u7EC6\u7EB2\u7684\u529F\u80FD\u8981\u6C42\uFF0C\u672A\u6CBF\u7528\u65E7Day1\u539F\u578B\u7684\u4E09\u9898\u5185\u5BB9\u6216\u6D4B\u8BD5\u95E8\u7981\u903B\u8F91\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D60\u2014\u6B63\u6587\u6BB5\u843D68"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D60]\n1.\u52D8\u5BDF\u961F\u5165\u9A7B\u79D1\u8003\u7AD9\uFF0C\u8FDB\u884C\u5165\u7AD9\u8BA4\u77E5\u6D4B\u8BD5\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D62]\n\u573A\u666F\uFF1A5.\u8BA4\u77E5\u7F13\u51B2\u95F4\uFF08\u7F13\u51B2\u533A\uFF09\uFF0C\u5916\u754C\u4E0E\u79D1\u8003\u7AD9\u5185\u90E8\u7684\u8FDE\u63A5\u533A\u57DF\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D64]\n\u9053\u5177\uFF1A5.\u8EAB\u4EFD\u8BA4\u8BC1\u5361\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D66]\n\u4E8B\u4EF6\uFF1A\u5F00\u59CB\u6E38\u620F\u65F6\u73A9\u5BB6\u81EA\u52A8\u8FDB\u5165\u4E00\u4E2A\u95EE\u7B54\u6D4B\u8BD5\uFF0C\u73A9\u5BB6\u9009\u62E9\u5B8C\u6BD5\u4F1A\u5F97\u5230\u8EAB\u4EFD\u8BA4\u8BC1\u5361\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D68]\n\u8BF4\u660E\uFF1A\u7F13\u51B2\u95F4\u662F\u8FDB\u5165\u5B9E\u9A8C\u5BA4\u524D\u8FC7\u7528\u4E8E\u6D88\u6BD2\uFF0C\u66F4\u8863\u7684\uFF0C\u7A7A\u95F4\u6781\u5C0F\u7684\u623F\u95F4\u3002\u56E0\u4E3A\u8680\u6D77\u73AF\u5883\u4E0B\u6709\u8BA4\u77E5\u5371\u5BB3\uFF0C\u9700\u8981\u8BA4\u77E5\u7F13\u51B2\u95F4\u68C0\u6D4B\uFF0C\u6821\u51C6\u7CBE\u795E\u72B6\u6001\uFF0C\u540C\u65F6\u5177\u6709\u8EAB\u4EFD\u767B\u8BB0\u529F\u80FD"
