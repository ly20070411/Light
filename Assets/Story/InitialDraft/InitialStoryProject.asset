  - id: route-te
    eventNumber: 
    title: "TE\u540E\u7EED\u5165\u53E3\uFF08\u7EC6\u7EB2\u5F85\u8865\uFF09"
    route: TE
    kind: "\u8DEF\u7EBF\u5165\u53E3\u5360\u4F4D"
    summary: "\u65B0\u7EC6\u7EB2\u5217\u6709TE\uFF0C\u9690\u85CF\u503C\u22653\u8FDB\u5165HE/TE\u8DEF\u7EBF\uFF1BTE\u7684\u7EC6\u5206\u6761\u4EF6\u4E0E\u4E8B\u4EF6\u672A\u63D0\u4F9B\u3002"
    trigger: "\u5F85\u8865\uFF1A\u6EE1\u8DB3HE/TE\u8DEF\u7EBF\u4E2D\u7684TE\u7EC6\u5206\u6761\u4EF6\u3002"
    completion: "\u540E\u7EEDTE\u5177\u4F53\u4E8B\u4EF6\u5F85\u8865\u3002"
    interaction: 
    staging: 
    designNotes: "\u4EC5\u767B\u8BB0\u5165\u53E3\uFF1B\u4E0D\u6CBF\u7528\u65E7\u5927\u7EB2\u9690\u85CF\u9053\u5177\u3001\u6A21\u56E0\u751F\u547D\u6216\u7ED3\u5C40\u540D\u79F0\u3002Day4\u4E3A\u63A5\u7EED\u5360\u4F4D\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D48\u2014\u6B63\u6587\u6BB5\u843D54"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D48]\n\u7ED3\u5C40\u5206\u4E3A\uFF1AHE\uFF0CNE\uFF0CBE\uFF0CTE\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D50]\n\u7531\u4E8E\u524D\u4E00\u652F\u79D1\u8003\u961F\u5904\u4E8E\u6A21\u56E0\u63A9\u4F53\uFF0C\u4E3B\u89D2\u961F\u4F0D\u5728\u767B\u9646\u65F6\u88AB\u5C4F\u853D\u4E86\u201C\u672C\u6B21\u4EFB\u52A1\u4EE5\u641C\u6551\u4E3A\u76EE\u6807\u201D\u7684\u8BA4\u77E5\uFF0C\u9700\u8981\u73A9\u5BB6\u53D1\u73B0\u573A\u666F\u4E2D\u7684\u4E0D\u534F\u8C03\u4E4B\u5904\uFF0C\u79EF\u7D2F\u9690\u85CF\u503C\uFF0C\u786E\u4FDD\u5728\u7B2C\u4E09\u65E5\u665A\u4E0A\u8FBE\u5230\u4E00\u5B9A\u7684\u9690\u85CF\u503C\uFF0C\u624D\u80FD\u89E6\u53D1HE\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D52]\n\u5305\u62EC\u4EFB\u52A1\u9690\u85CF\u503C\u4E0E\u989D\u5916\u9690\u85CF\u503C\uFF1A\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D53]\n\u4EFB\u52A1\u9690\u85CF\u503C\uFF1A\u5728\u4E3B\u7EBF\u7684\u5F15\u5BFC\u4E0B\uFF0C\u8FBE\u6210\u7279\u5B9A\u6761\u4EF6\u83B7\u5F97\u9690\u85CF\u503C\uFF0C\u83B7\u5F97\u9690\u85CF\u503C\u7684\u4E8B\u4EF6\u6709\u56DB\u4E2A\uFF0C\u9690\u85CF\u503C\u5927\u4E8E\u7B49\u4E8E\u4E09\u8FDB\u5165HE/TE\u7EBF\uFF0C\u5C0F\u4E8E\u4E09\u8FDB\u5165NE/BE\u7EBF\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D54]\n\u989D\u5916\u9690\u85CF\u503C\uFF1A\u5728\u573A\u666F\u4E2D\u5B8C\u6210\u6210\u529F\u7387\u6781\u4F4E\u7684\u68C0\u5B9A\u6216\u8F83\u96BE\u7684\u89E3\u5BC6\uFF0C\u83B7\u5F97\u989D\u5916\u7EBF\u7D22\u79EF\u7D2F\u9690\u85CF\u503C\uFF08\u6B21\u8981\uFF09"
