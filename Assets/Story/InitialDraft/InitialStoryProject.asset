    title: "\u8239\u957F\u5BA4\u65E5\u5FD7\u4E0E\u626D\u66F2\u751F\u7269\u88AD\u51FB"
    route: "\u5171\u901A"
    kind: "\u4E3B\u7EBF\u4E8B\u4EF6"
    summary: "\u641C\u7D22\u94A5\u5319\u8FDB\u5165\u8239\u957F\u5BA4\uFF0C\u4FEE\u590D\u635F\u574F\u822A\u884C\u65E5\u5FD7\uFF1B\u4FE1\u606F\u626D\u66F2\u751F\u7269\u4ECE\u95E8\u53E3\u51B2\u6765\uFF0C\u865E\u9752\u66FF\u4E3B\u89D2\u6321\u4E0B\u653B\u51FB\uFF0C\u8FDB\u5165\u7CBE\u82F1\u6218\u3002"
    trigger: "\u627E\u5230\u94A5\u5319\u5E76\u8FDB\u5165\u8239\u957F\u5BA4\u3002"
    completion: "\u5B8C\u6210\u65E5\u5FD7\u76F8\u5173\u6F14\u51FA\u4E0E\u7CBE\u82F1\u6218\u6597\u3002"
    interaction: "\u641C\u7D22\u94A5\u5319 \u2192 \u5F00\u8239\u957F\u5BA4 \u2192
      \u4FEE\u590D\u65E5\u5FD7 \u2192 \u7A81\u88AD\u6F14\u51FA \u2192 \u7CBE\u82F1\u6218\u3002"
    staging: "\u6853\u7389\u9274\u80CC\u5BF9\u5165\u53E3\uFF0C\u865E\u9752\u9760\u8FD1\u95E8\u53E3\uFF1B\u5510\u6666\u548C\u5E38\u6708\u5BB9\u5728\u9694\u95F4\u5206\u5934\u6536\u96C6\u6570\u636E\u3002"
    designNotes: "\u65E5\u5FD7\u5177\u4F53\u5185\u5BB9\u3001\u4FEE\u590D\u624B\u6BB5\uFF0F\u68C0\u5B9A\u3001\u654C\u4EBA\u6570\u636E\u3001\u865E\u9752\u53D7\u4F24\u72B6\u6001\u4E0E\u6218\u8D25\u6D41\u7A0B\u5F85\u8865\u3002"
    source: "\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D200\u2014\u6B63\u6587\u6BB5\u843D207"
    sourceText: "[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D200]\n\u73A9\u5BB6\u5728\u573A\u666F\u4E2D\u641C\u7D22\u8239\u957F\u5BA4\u94A5\u5319\uFF0C\u8FDB\u5165\u8239\u957F\u5BA4\uFF0C\u4FEE\u590D\u6570\u636E\u635F\u574F\u7684\u822A\u884C\u65E5\u5FD7\uFF0C\u8FD9\u65F6\u67D0\u4E2A\u4FE1\u606F\u88AB\u626D\u66F2\u7684\u751F\u7269\u4ECE\u80CC\u540E\u51B2\u8FDB\u6765\uFF0C\u5411\u4E3B\u89D2\u88AD\u6765\uFF0C\u865E\u9752\u66FF\u4E3B\u89D2\u6321\u4E0B\u4E86\u653B\u51FB\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D202]\n\u573A\u666F\uFF1A\u8239\u957F\u5BA4\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D204]\n\u4E8B\u4EF6\uFF1A\u4E3B\u89D2\uFF0C\u5510\u6666\uFF0C\u5E38\u6708\u5BB9\uFF0C\u865E\u9752\u5728\u8239\u957F\u5BA4\u5206\u5934\u641C\u96C6\u6570\u636E\uFF0C\u4E3B\u89D2\u80CC\u5BF9\u5165\u53E3\uFF0C\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D205]\n\u5510\u6666\u4E0E\u5E38\u6708\u5BB9\u5728\u9694\u95F4\uFF0C\u626D\u66F2\u751F\u7269\u81EA\u95E8\u53E3\u51B2\u5165\uFF0C\u9760\u8FD1\u95E8\u53E3\u7684\u865E\u9752\u4E3A\u4E3B\u89D2\u6321\u4E0B\u653B\u51FB\uFF0C\u8FDB\u5165\u7CBE\u82F1\u602A\u6218\u6597\n\n[\u7EC6\u7EB2.docx/\u6B63\u6587\u6BB5\u843D207]\n\u8BF4\u660E\uFF1A\u9636\u6BB5\u6027\u6218\u6597"
