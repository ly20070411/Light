    designNotes: "\u4EC5\u4FDD\u7559\u65B0\u7EC6\u7EB2\u786E\u8BA4\u7684\u5165\u53E3\uFF0C\u4E0D\u7528\u65E7\u5927\u7EB2\u8865\u5199HE\u51FB\u8D25\u9006\u6A21\u56E0\u6216TE\u9690\u85CF\u9053\u5177\u673A\u5236\u3002Day4\u4EC5\u4E3A\u8DEF\u7EBF\u63A5\u7EED\u5360\u4F4D\uFF0C\u4E0D\u65AD\u8A00\u65B0\u7248HE\u7684\u65E5\u7A0B\u3002"
