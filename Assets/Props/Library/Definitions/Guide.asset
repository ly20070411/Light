  dialogue:
  - speaker: "\u5411\u5BFC"
    text: "\u6211\u7684\u5916\u89C2\u4F7F\u7528\u5E27\u52A8\u753B\u3002\u4F60\u4E5F\u53EF\u4EE5\u5728\u9053\u5177\u7F16\u8F91\u5668\u4E2D\u6539\u7528
      Animator\uFF0C\u6216\u6307\u5B9A\u5916\u89C2\u9884\u5236\u4F53\u3002"
    portrait: {fileID: 0}
  itemHandover:
    enabled: 1
    itemKey: fruit
    amount: 1
    completionFlag: guide_fruit_given
    acceptLabel: "\u4EA4\u7ED9\u679C\u5B9E"
    declineLabel: "\u4E0D\u7ED9"
    offerDialogue:
    - speaker: "\u5411\u5BFC"
      text: "\u4F60\u627E\u5230\u679C\u5B9E\u4E86\uFF01\u80FD\u5206\u7ED9\u6211\u4E00\u9897\u5417\uFF1F\u6211\u5DF2\u7ECF\u5F88\u4E45\u6CA1\u5403\u4E1C\u897F\u4E86\u3002"
      portrait: {fileID: 0}
    acceptedDialogue:
    - speaker: "\u5411\u5BFC"
      text: "\u8C22\u8C22\u4F60\uFF0C\u8FD9\u9897\u679C\u5B9E\u6B63\u597D\u80FD\u8BA9\u6211\u6062\u590D\u4F53\u529B\u3002"
      portrait: {fileID: 0}
    - speaker: "\u5411\u5BFC"
      text: "\u6709\u4E86\u8FD9\u4EFD\u8865\u7ED9\uFF0C\u6211\u53EF\u4EE5\u7EE7\u7EED\u4E3A\u8FC7\u8DEF\u7684\u4EBA\u6307\u8DEF\u4E86\u3002\u4F60\u4E5F\u8BB0\u5F97\u7167\u987E\u597D\u81EA\u5DF1\u3002"
      portrait: {fileID: 0}
    declinedDialogue:
    - speaker: "\u5411\u5BFC"
      text: "\u6CA1\u5173\u7CFB\uFF0C\u679C\u5B9E\u5148\u7559\u7ED9\u4F60\u81EA\u5DF1\u5427\u3002\u6539\u53D8\u4E3B\u610F\u65F6\u518D\u6765\u627E\u6211\u3002"
      portrait: {fileID: 0}
    missingItemDialogue:
    - speaker: "\u5411\u5BFC"
      text: "\u6211\u6709\u4E9B\u997F\u4E86\u3002\u9644\u8FD1\u4F3C\u4E4E\u6389\u843D\u4E86\u4E00\u9897\u679C\u5B9E\uFF0C\u627E\u5230\u540E\u53EF\u4EE5\u5E26\u7ED9\u6211\u5417\uFF1F"
      portrait: {fileID: 0}
    completedDialogue:
    - speaker: "\u5411\u5BFC"
      text: "\u591A\u4E8F\u4E86\u4F60\u5E26\u6765\u7684\u679C\u5B9E\uFF0C\u6211\u73B0\u5728\u7CBE\u795E\u591A\u4E86\u3002\u8C22\u8C22\u4F60\uFF01"
      portrait: {fileID: 0}
