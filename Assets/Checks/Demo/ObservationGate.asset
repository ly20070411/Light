    behavior: 1
    targetValue: 9
    requiredFlags: []
    requiredItemKey: repair-kit
    requiredItemAmount: 1
    consumeRequiredItem: 1
    success:
      text: "\u4F60\u7528\u7EF4\u4FEE\u5305\u66FF\u6362\u4E86\u70E7\u6BC1\u7684\u7EBF\u8DEF\uFF0C\u95E8\u63A7\u6062\u590D\u6B63\u5E38\u3002"
      continuation: "\u9694\u79BB\u95E8\u6253\u5F00\u3002\u4F60\u8FDB\u5165\u89C2\u6D4B\u7AD9\u3002"
